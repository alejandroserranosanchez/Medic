# Copy this file to .env and replace every value.
# .env is ignored by Git. Do not put these passwords in source, Compose, or the image.
# Use letters and digits only, at least 8 characters, with upper case, lower case, and a digit.
# A symbol such as ! or $ breaks the init script's quoting.

# Administrator login for the local SQL Server container. The clinic services must not use it.
MSSQL_SA_PASSWORD=ReplaceWithLocalAdminPassword1

# Login that will own the operations database only.
OPERATIONS_DB_PASSWORD=ReplaceWithOperationsPassword1

# Login that will own the finance database only.
FINANCE_DB_PASSWORD=ReplaceWithFinancePassword1

# Host port published from the container's 1433. Change it if 1433 is already taken.
SQL_PORT=1433
